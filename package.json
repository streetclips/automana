{
  "name": "palmwalker",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "description": "Palmwalker: a solo in-hand dueling card game. Card content, a live card preview and print-and-play PDFs.",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "preview": "tsx watch src/preview/server.ts",
    "play": "tsx watch src/play/server.ts",
    "pnp": "tsx src/pnp/build.ts",
    "pnp:box": "tsx src/pnp/build.ts box",
    "art": "tsx src/art/generate.ts",
    "build": "npm run typecheck && npm run pnp",
    "sim": "tsx src/sim/batch/run.ts",
    "sim:trace": "tsx src/sim/trace.ts",
    "sim:test": "tsx src/sim/selftest.ts",
    "sim:tune": "tsx src/sim/batch/tune.ts",
    "box:cards": "tsx src/box/cards.ts",
    "box:test": "tsx src/box/selftest.ts",
    "box": "tsx src/box/sim.ts",
    "box:trace": "tsx src/box/trace.ts",
    "box:test:nemesis": "tsx src/box/nemesis/selftest.ts"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
