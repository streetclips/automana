{
  "name": "automana",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "description": "Automana: Nemesis decks to play solo against Magic Beginner Box decks. Engine, balance simulation, card preview and print-and-play PDFs.",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "preview": "tsx watch src/preview/server.ts",
    "pnp": "tsx src/pnp/build.ts",
    "rulebook": "tsx src/rulebook/build.ts",
    "art": "tsx src/art/generate.ts",
    "readme:images": "tsx src/readme/images.ts",
    "build": "npm run typecheck && npm run pnp && npm run rulebook",
    "box:cards": "tsx src/box/cards.ts",
    "box:test": "tsx src/box/selftest.ts",
    "box": "tsx src/box/sim.ts",
    "box:trace": "tsx src/box/trace.ts",
    "box:test:nemesis": "tsx src/box/nemesis/selftest.ts",
    "box:test:challenges": "tsx src/box/nemesis/challenge-selftest.ts"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
