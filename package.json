{
  "name": "palmwalker",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "Palmwalker: a solo in-hand dueling card game. Card content and a printable card sheet.",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "cards": "tsx src/sheet/build.ts",
    "pnp": "tsx src/pnp/build.ts",
    "art": "tsx src/art/generate.ts",
    "build": "npm run typecheck && npm run cards",
    "sim": "tsx src/sim/batch/run.ts",
    "sim:trace": "tsx src/sim/trace.ts",
    "sim:test": "tsx src/sim/selftest.ts",
    "sim:tune": "tsx src/sim/batch/tune.ts"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
